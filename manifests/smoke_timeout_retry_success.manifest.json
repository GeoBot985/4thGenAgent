{
  "manifest_id": "smoke.timeout_retry_success",
  "name": "Smoke Test - Timeout Retry Success",
  "version": 1,
  "trigger": {
    "type": "manual"
  },
  "inputs": [],
  "steps": [
    {
      "id": "run_slow_then_fast_tool",
      "timeout_seconds": 0.1,
      "retry": {
        "max_attempts": 2,
        "delay_seconds": 0,
        "retry_on": ["timeout"]
      },
      "command": "[t:fake/slow_then_fast -> result]"
    }
  ],
  "validations": [
    {
      "id": "no_step_failed",
      "type": "no_step_failed"
    },
    {
      "id": "step_completed",
      "type": "step_completed",
      "step": "run_slow_then_fast_tool"
    },
    {
      "id": "attempts_equal_two",
      "type": "attempt_count_equals",
      "step": "run_slow_then_fast_tool",
      "count": 2
    },
    {
      "id": "result_output_exists",
      "type": "output_exists",
      "output": "result"
    }
  ],
  "completion": {
    "success_outputs": ["result"]
  }
}
