{
  "manifest_id": "smoke.live_sheet_create_allowed",
  "name": "Smoke Test - Live Sheet Create Allowed",
  "version": 1,
  "live_execution": {
    "enabled": true,
    "allowed_tools": ["sheet/create"],
    "requires_approval": true
  },
  "trigger": {
    "type": "manual"
  },
  "inputs": [
    "title"
  ],
  "steps": [
    {
      "id": "stage_sheet_create",
      "command": "[t:sheet/create -> created_sheet] title=$inputs.title"
    }
  ],
  "validations": [
    {
      "id": "no_runtime_errors",
      "type": "no_errors"
    },
    {
      "id": "sheet_create_staged",
      "type": "step_staged",
      "step": "stage_sheet_create"
    },
    {
      "id": "sheet_create_pending",
      "type": "pending_action_exists",
      "tool": "sheet/create",
      "output": "created_sheet"
    }
  ],
  "completion": {
    "success_pending_actions": ["created_sheet"],
    "success_executed_actions": ["created_sheet"],
    "success_outputs": ["created_sheet"],
    "allow_pending_approval": true
  }
}
