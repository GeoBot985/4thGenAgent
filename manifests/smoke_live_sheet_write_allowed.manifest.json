{
  "manifest_id": "smoke.live_sheet_write_allowed",
  "name": "Smoke Test - Live Sheet Write Allowed",
  "version": 1,
  "live_execution": {
    "enabled": true,
    "allowed_tools": ["sheet/write"],
    "requires_approval": true
  },
  "trigger": {
    "type": "manual"
  },
  "inputs": [
    "spreadsheet_id",
    "range_name",
    "values_json",
    "mode"
  ],
  "steps": [
    {
      "id": "stage_sheet_write",
      "command": "[t:sheet/write -> write_result] spreadsheet_id=$inputs.spreadsheet_id; range_name=$inputs.range_name; values_json=$inputs.values_json; mode=$inputs.mode"
    }
  ],
  "validations": [
    {
      "id": "no_runtime_errors",
      "type": "no_errors"
    },
    {
      "id": "sheet_write_staged",
      "type": "step_staged",
      "step": "stage_sheet_write"
    },
    {
      "id": "sheet_write_pending",
      "type": "pending_action_exists",
      "tool": "sheet/write",
      "output": "write_result"
    }
  ],
  "completion": {
    "success_pending_actions": ["write_result"],
    "success_executed_actions": ["write_result"],
    "success_outputs": ["write_result"],
    "allow_pending_approval": true
  }
}
