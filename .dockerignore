# Keep the build context small and free of secrets / local state.

# Secrets & auth material (must never enter an image)
secrets.json
token.json
google_token.json
credentials.json
client_secret*.json
config/*credentials*.json
config/*token*.json
config/*.local.json
.env
.env.*
!.env.example

# Local runtime state and generated artifacts
runtime_data/
tmp-e2e/
consolidated_sources_part_*.txt
.clone/

# Python caches / build outputs
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# VCS & tooling
.git/
.github/
.claude/
.gitignore

# Tests are not needed in the production image
tests/
