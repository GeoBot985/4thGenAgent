# Customer bundle environment — copy to .env in this bundle and fill in.
# Generate each token with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit the filled-in .env. Never bake it into the image.

# --- Backend auth (REQUIRED) ---
TASKFRAME_BACKEND_ADMIN_TOKEN=replace-with-strong-admin-token
TASKFRAME_BACKEND_OPERATOR_TOKEN=replace-with-strong-operator-token
TASKFRAME_BACKEND_VIEWER_TOKEN=replace-with-strong-viewer-token
TASKFRAME_BACKEND_AUTH_ENABLED=true
TASKFRAME_BACKEND_ALLOW_DEV_BYPASS=false

# --- Bundle wiring (set by the compose override; listed here for clarity) ---
# TASKFRAME_CONFIG_DIR=/bundle/config
# TASKFRAME_RUNTIME_DIR=/bundle/runtime_data

# --- Safety: live execution stays OFF for a read-only pilot ---
TASKFRAME_ENABLE_LIVE_EXECUTION=0
