{
  "manifest_id": "gallery.input_used_but_not_declared",
  "name": "Gallery: Input Used But Not Declared",
  "version": 1,
  "trigger": {"type": "manual"},
  "inputs": [],
  "steps": [
    {"id": "read_data", "command": "[t:g/check -> result] query=$inputs.message max_results=5"}
  ],
  "validations": [
    {"id": "no_errors", "type": "no_errors"},
    {"id": "result_exists", "type": "output_exists", "output": "result"}
  ],
  "completion": {
    "success_outputs": ["result"],
    "acceptable_empty_outputs": ["result"]
  },
  "live_execution": {"enabled": false, "requires_approval": true}
}
