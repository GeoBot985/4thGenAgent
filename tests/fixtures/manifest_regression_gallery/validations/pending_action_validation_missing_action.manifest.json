{
  "manifest_id": "gallery.pending_action_validation_missing_action",
  "name": "Pending Action Validation Missing Action",
  "version": 1,
  "trigger": {
    "type": "manual"
  },
  "inputs": [
    "message"
  ],
  "steps": [
    {
      "id": "echo_message",
      "kind": "tool",
      "command": "[t:test/echo -> result] message=$inputs.message"
    }
  ],
  "validations": [
    {
      "id": "pending_check",
      "type": "pending_action_exists"
    }
  ],
  "completion": {
    "success_outputs": ["result"]
  },
  "side_effect_policy": {
    "has_side_effects": false,
    "requires_approval": false,
    "live_execution_allowed": false,
    "allowed_side_effect_tools": []
  }
}
