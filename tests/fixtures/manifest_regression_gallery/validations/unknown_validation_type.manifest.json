{
  "manifest_id": "gallery.unknown_validation_type",
  "name": "Unknown Validation Type",
  "version": 1,
  "trigger": {
    "type": "manual"
  },
  "inputs": [
    "message"
  ],
  "steps": [
    {
      "id": "echo_message",
      "kind": "tool",
      "command": "[t:test/echo -> result] message=$inputs.message"
    }
  ],
  "validations": [
    {
      "id": "bad_validation",
      "type": "totally_unknown",
      "output": "result"
    }
  ],
  "completion": {
    "success_outputs": ["result"]
  },
  "side_effect_policy": {
    "has_side_effects": false,
    "requires_approval": false,
    "live_execution_allowed": false,
    "allowed_side_effect_tools": []
  }
}
