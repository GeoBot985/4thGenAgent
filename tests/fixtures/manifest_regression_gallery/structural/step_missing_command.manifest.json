{
  "manifest_id": "gallery.step_missing_command",
  "name": "Step Missing Command",
  "version": 1,
  "trigger": {
    "type": "manual"
  },
  "inputs": [
    "message"
  ],
  "steps": [
    {
      "id": "echo_message",
      "kind": "tool"
    }
  ],
  "validations": [
    {
      "id": "result_exists",
      "type": "output_exists",
      "output": "result"
    }
  ],
  "completion": {
    "success_outputs": ["result"]
  },
  "side_effect_policy": {
    "has_side_effects": false,
    "requires_approval": false,
    "live_execution_allowed": false,
    "allowed_side_effect_tools": []
  }
}
