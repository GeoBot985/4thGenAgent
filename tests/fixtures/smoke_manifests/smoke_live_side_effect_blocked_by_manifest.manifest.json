{
  "manifest_id": "smoke.live_side_effect_blocked_by_manifest",
  "name": "Smoke Test - Live Side Effect Blocked By Manifest",
  "version": 1,
  "live_execution": {
    "enabled": false,
    "allowed_tools": [],
    "requires_approval": true
  },
  "trigger": {
    "type": "manual"
  },
  "inputs": [
    "title"
  ],
  "steps": [
    {
      "id": "stage_sheet_create",
      "command": "[t:sheet/create -> created_sheet] title=$inputs.title"
    }
  ],
  "validations": [
    {
      "id": "sheet_create_pending",
      "type": "pending_action_exists",
      "tool": "sheet/create",
      "output": "created_sheet"
    }
  ],
  "completion": {
    "success_pending_actions": ["created_sheet"],
    "allow_pending_approval": true
  }
}
