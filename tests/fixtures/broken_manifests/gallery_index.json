{
  "version": 1,
  "fixtures": [
    {
      "id": "completion_output_missing",
      "path": "completion_output_missing.manifest.json",
      "description": "Completion references an output alias that no step produces.",
      "expected_validation_ok": false,
      "expected_smoke_classification": "COMPLETION_FAILED",
      "expected_findings": ["completion_output_missing"],
      "expected_autofix": {
        "supported": true,
        "finding_id": "completion_output_missing",
        "status": "PROPOSED",
        "risk": "low"
      },
      "notes": ""
    },
    {
      "id": "validation_output_missing",
      "path": "validation_output_missing.manifest.json",
      "description": "A validation rule checks an output alias that no step produces.",
      "expected_validation_ok": false,
      "expected_smoke_classification": "VALIDATION_FAILED",
      "expected_findings": ["validation_references_missing_output"],
      "expected_autofix": {
        "supported": true,
        "finding_id": "validation_references_missing_output",
        "status": "PROPOSED",
        "risk": "low"
      },
      "notes": "Static analysis finding ID is validation_references_missing_output; autofix handles both aliases."
    },
    {
      "id": "unknown_tool",
      "path": "unknown_tool.manifest.json",
      "description": "A step command references an unregistered tool namespace.",
      "expected_validation_ok": true,
      "expected_smoke_classification": "TOOL_NOT_REGISTERED",
      "expected_findings": [],
      "expected_autofix": {
        "supported": false,
        "finding_id": "unknown_tool",
        "status": "NOT_SUPPORTED",
        "risk": "blocked"
      },
      "notes": "Static analysis cannot detect unregistered tools. Finding only appears in smoke results."
    },
    {
