# TaskFrame Runtime — on-prem pilot environment template.
# Copy to .env and replace every token with a strong, unique secret.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Do NOT commit the filled-in .env. It is gitignored.

# --- Backend auth (REQUIRED) -------------------------------------------------
# Bearer tokens consumed by the API. Each maps to a role (admin > operator > viewer).
TASKFRAME_BACKEND_ADMIN_TOKEN=replace-with-strong-admin-token
TASKFRAME_BACKEND_OPERATOR_TOKEN=replace-with-strong-operator-token
TASKFRAME_BACKEND_VIEWER_TOKEN=replace-with-strong-viewer-token

# Auth is ON by default. Never disable it for a pilot. The dev bypass below must
# stay false outside local development.
TASKFRAME_BACKEND_AUTH_ENABLED=true
TASKFRAME_BACKEND_ALLOW_DEV_BYPASS=false

# --- Server tuning (optional) ------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=2
